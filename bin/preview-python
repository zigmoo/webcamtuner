#!/usr/bin/env bash
set -euo pipefail
WEBCAMTUNER_PYTHON="${XDG_DATA_HOME:-$HOME/.local/share}/webcamtuner/runtime/bin/python"
WEBCAMTUNER_GPU_RUNTIME="${XDG_DATA_HOME:-$HOME/.local/share}/webcamtuner/runtime-gpu"
if [[ -f "$WEBCAMTUNER_GPU_RUNTIME/enabled.json" && -x "$WEBCAMTUNER_GPU_RUNTIME/bin/python" && "${WEBCAMTUNER_FORCE_CPU:-0}" != 1 ]]; then
  WEBCAMTUNER_PYTHON="$WEBCAMTUNER_GPU_RUNTIME/bin/python"
fi
if [[ -n "${WEBCAMTUNER_RUNTIME_PYTHON:-}" ]]; then
  [[ "$WEBCAMTUNER_RUNTIME_PYTHON" = /* ]] || exit 1
  WEBCAMTUNER_PYTHON="$WEBCAMTUNER_RUNTIME_PYTHON"
fi
if [[ ! -x "$WEBCAMTUNER_PYTHON" ]]; then
  printf '%s\n' '{"error":"Open WebcamTuner → Setup and click Prepare WebcamTuner."}'
  exit 1
fi
# Resolve the venv directory, retaining its bin/python link and venv semantics.
if [[ -z "${WEBCAMTUNER_RUNTIME_PYTHON:-}" ]]; then
  WEBCAMTUNER_RUNTIME_DIR="$(readlink -f -- "$(dirname -- "$WEBCAMTUNER_PYTHON")/..")"
  WEBCAMTUNER_PYTHON="$WEBCAMTUNER_RUNTIME_DIR/bin/python"
fi
WEBCAMTUNER_MEDIA="${XDG_DATA_HOME:-$HOME/.local/share}/webcamtuner/media/current"
if [[ -d "$WEBCAMTUNER_MEDIA" ]]; then
  export GST_PLUGIN_PATH_1_0="$(readlink -f -- "$WEBCAMTUNER_MEDIA")${GST_PLUGIN_PATH_1_0:+:$GST_PLUGIN_PATH_1_0}"
  if [[ -d "$WEBCAMTUNER_MEDIA/lib" ]]; then
    export LD_LIBRARY_PATH="$(readlink -f -- "$WEBCAMTUNER_MEDIA/lib")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  fi
fi
export ORT_DISABLE_TELEMETRY=1 PYTHONDONTWRITEBYTECODE=1 DO_NOT_TRACK=1
# oneTBB can unload libtcm from a worker while its exit destructor is running.
# Keep a loader reference for this helper process; preserve any camera adapter.
WEBCAMTUNER_TCM_LIBRARY="${WEBCAMTUNER_TCM_LIBRARY:-/usr/lib/libtcm.so.1}"
if [[ "$WEBCAMTUNER_TCM_LIBRARY" = /* && -f "$WEBCAMTUNER_TCM_LIBRARY" ]]; then
  case ":${LD_PRELOAD:-}:" in
    *:"$WEBCAMTUNER_TCM_LIBRARY":*) ;;
    *) export LD_PRELOAD="$WEBCAMTUNER_TCM_LIBRARY${LD_PRELOAD:+:$LD_PRELOAD}" ;;
  esac
fi
exec "$WEBCAMTUNER_PYTHON" "$@"
